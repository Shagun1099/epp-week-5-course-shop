@page
@model CheckoutModel
@{
    ViewData["Title"] = "Checkout";
}
<section class="esh-catalog-hero">
    <div class="container">
        <img class="esh-catalog-title" src="~/images/main_banner_text.png" />
    </div>
</section>

<div class="container">
    <h1>Review</h1>
    @if (Model.BasketModel.Items.Any())
    {
        <form asp-page="Checkout" method="post">
            <article class="esh-basket-titles row">
                <br />
                <section class="esh-basket-title col-xs-3">Course</section>
                <section class="esh-basket-title col-xs-3 hidden-lg-down"></section>
                <section class="esh-basket-title col-xs-2">Price</section>
                <section class="esh-basket-title col-xs-2">Seats</section>
                <section class="esh-basket-title col-xs-2">Cost</section>
            </article>
            <div class="esh-catalog-items row">
                <div asp-validation-summary="All" class="text-danger"></div>
                @for (int i = 0; i < Model.BasketModel.Items.Count; i++)
                {
                    var item = Model.BasketModel.Items[i];
                    <article class="esh-basket-items row">
                        <div>
                            <section class="esh-basket-item esh-basket-item--middle col-lg-3 hidden-lg-down">
                                <img class="esh-basket-image" src="@item.PictureUrl" />
                            </section>
                            <section class="esh-basket-item esh-basket-item--middle col-xs-3">@item.ProductName</section>
                            <section class="esh-basket-item esh-basket-item--middle col-xs-2">$ @item.UnitPrice.ToString("N2")</section>
                            <section class="esh-basket-item esh-basket-item--middle col-xs-2">
                                <input type="hidden" name="@("Items[" + i + "].Id")" value="@item.Id" />
                                <input type="hidden" name="@("Items[" + i + "].Quantity")" value="@item.Quantity" />
                                @item.Quantity
                            </section>
                            <section class="esh-basket-item esh-basket-item--middle esh-basket-item--mark col-xs-2">$ @Math.Round(item.Quantity * item.UnitPrice, 2).ToString("N2")</section>
                        </div>
                        <div class="row">

                        </div>
                    </article>
                }

                <div class="container">
                    <article class="esh-basket-items row">
                        <section class="esh-basket-item col-xs-8">
                            <label>
                                <input type="checkbox" asp-for="PrintedCertificate"
                                       data-cert-price="@Model.CertificateUnitPrice"
                                       data-base-total="@(Model.BasketModel.Total() + Model.BookingFee)" />
                                Add a printed certificate ($@Model.CertificateUnitPrice.ToString("N2") per purchase)
                            </label>
                        </section>
                    </article>

                    <article class="esh-basket-titles esh-basket-titles--clean row">
                        <section class="esh-basket-title col-xs-4"></section>
                        <section class="esh-basket-title col-xs-2">Subtotal</section>
                        <section class="esh-basket-title col-xs-2">Booking fee</section>
                        <section class="esh-basket-title col-xs-2">Certificate</section>
                        <section class="esh-basket-title col-xs-2">Total</section>
                    </article>

                    <article class="esh-basket-items row">
                        <section class="esh-basket-item col-xs-4"></section>
                        <section class="esh-basket-item col-xs-2">$ @Model.BasketModel.Total().ToString("N2")</section>
                        <section class="esh-basket-item col-xs-2">$ @Model.BookingFee.ToString("N2")</section>
                        <section id="cert-total" class="esh-basket-item col-xs-2">$ @Model.CertificateTotal.ToString("N2")</section>
                        <section id="order-total" class="esh-basket-item esh-basket-item--mark col-xs-2">$ @((Model.BasketModel.Total() + Model.BookingFee + Model.CertificateTotal).ToString("N2"))</section>
                    </article>

                    <article class="esh-basket-items row">
                        <section class="esh-basket-item col-xs-7"></section>
                    </article>
                </div>
                <div class="row">
                    <section class="esh-basket-item col-xs-1">
                        <a asp-page="Index" class="btn esh-basket-checkout text-white">[ Back ]</a>
                    </section>
                    <section class="esh-basket-item col-xs-push-7 col-xs-4 text-right">
                        <input type="submit" class="btn esh-basket-checkout" value="[ Pay Now ]" />
                    </section>
                </div>
            </div>
        </form>

        <script>
            (function () {
                var cb = document.getElementById('PrintedCertificate');
                var certCell = document.getElementById('cert-total');
                var totalCell = document.getElementById('order-total');
                var certPrice = parseFloat(cb.dataset.certPrice);
                var baseTotal = parseFloat(cb.dataset.baseTotal);

                cb.addEventListener('change', function () {
                    var cert = cb.checked ? certPrice : 0;
                    certCell.textContent = '$ ' + cert.toFixed(2);
                    totalCell.textContent = '$ ' + (baseTotal + cert).toFixed(2);
                });
            })();
        </script>
    }
    else
    {
        <h3 class="esh-catalog-items row">
            Your cart is empty.
        </h3>

        <section class="esh-basket-item">
            <a asp-page="/Index" class="btn esh-basket-checkout text-white">[ Keep Browsing ]</a>
        </section>
    }
</div>
