@page
@model Microsoft.eShopWeb.Web.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Admin - Courses";
}

<div class="container">
    <h1>Courses</h1>
    <table class="table">
        <thead>
            <tr><th>Course</th><th>Price</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var course in Model.Courses)
            {
                <tr>
                    <td>@course.Name</td>
                    <td>$ @course.Price.ToString("N2")</td>
                    <td>
                        <a asp-page="/Admin/EditCatalogItem" asp-route-Id="@course.Id" asp-route-Name="@course.Name" asp-route-Price="@course.Price">Edit</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
